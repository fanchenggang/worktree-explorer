{
  "name": "git-worktree-explorer",
  "displayName": "Worktree Explorer for Cursor & IDEA",
  "description": "List git worktrees, add notes, and open them in Cursor or IntelliJ IDEA",
  "version": "0.3.0",
  "publisher": "fanchenggang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fanchenggang/worktree-explorer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onView:worktreeExplorer.list"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Worktree Explorer",
      "properties": {
        "worktreeExplorer.ideaCommand": {
          "type": "string",
          "default": "idea",
          "description": "Command used to open IntelliJ IDEA."
        },
        "worktreeExplorer.cursorCommand": {
          "type": "string",
          "default": "cursor",
          "description": "Command used to open Cursor when this extension is not running inside Cursor."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeExplorer",
          "title": "Worktrees",
          "icon": "media/worktree.svg"
        }
      ]
    },
    "views": {
      "worktreeExplorer": [
        {
          "id": "worktreeExplorer.list",
          "name": "Worktrees"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "worktreeExplorer.list",
        "contents": "No git repository in the current workspace."
      }
    ],
    "commands": [
      {
        "command": "worktreeExplorer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "worktreeExplorer.openCursor",
        "title": "Open in Cursor",
        "icon": "$(window)"
      },
      {
        "command": "worktreeExplorer.openIdea",
        "title": "Open in IDEA",
        "icon": "$(file-code)"
      },
      {
        "command": "worktreeExplorer.editNote",
        "title": "Edit Note",
        "icon": "$(pencil)"
      },
      {
        "command": "worktreeExplorer.openTerminal",
        "title": "Open in Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "worktreeExplorer.copyPath",
        "title": "Copy Path",
        "icon": "$(copy)"
      },
      {
        "command": "worktreeExplorer.prune",
        "title": "Prune Worktrees",
        "icon": "$(clear-all)"
      },
      {
        "command": "worktreeExplorer.createWorktree",
        "title": "Create Worktree Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "worktreeExplorer.deleteWorktree",
        "title": "Delete Worktree",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
      {
        "command": "worktreeExplorer.refresh",
        "when": "view == worktreeExplorer.list",
        "group": "navigation"
      },
      {
        "command": "worktreeExplorer.prune",
        "when": "view == worktreeExplorer.list",
        "group": "navigation"
      }
    ],
    "view/item/context": [
        {
          "command": "worktreeExplorer.openCursor",
          "when": "view == worktreeExplorer.list && viewItem == worktree",
          "group": "inline"
        },
        {
          "command": "worktreeExplorer.openIdea",
          "when": "view == worktreeExplorer.list && viewItem == worktree",
          "group": "inline"
        },
      {
        "command": "worktreeExplorer.editNote",
        "when": "view == worktreeExplorer.list && viewItem == worktree",
        "group": "inline"
      },
      {
        "command": "worktreeExplorer.openTerminal",
        "when": "view == worktreeExplorer.list && viewItem == worktree",
        "group": "navigation@1"
      },
      {
        "command": "worktreeExplorer.copyPath",
        "when": "view == worktreeExplorer.list && viewItem == worktree",
        "group": "navigation@2"
      },
      {
        "command": "worktreeExplorer.createWorktree",
        "when": "view == worktreeExplorer.list && viewItem == worktree",
          "group": "1_create"
        },
        {
          "command": "worktreeExplorer.deleteWorktree",
          "when": "view == worktreeExplorer.list && viewItem == worktree",
          "group": "2_delete"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/*.test.js",
    "package": "npx --yes @vscode/vsce@3.9.2 package"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.0"
  }
}
